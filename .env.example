# ---- 大模型（可选）----
# 可选：接入任意 OpenAI 兼容接口。不填则使用规则引擎模式。
#
# 智谱 GLM（本项目实测用的就是这套）：
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-5.3-flash
# DeepSeek：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.3-flash
# 设为 0 可强制关闭大模型（即使填了 key）
LLM_ENABLED=1

# 思考档位 low / high / max。GLM-5.3-Flash 这类推理模型「始终思考」，
# 不支持关闭（发 type=disabled 会返回 1210），只能调档。取数判断不需要长链推理，给 low。
# 注意：这个参数只在请求带 tools 时才被接受，不带 tools 会被拒。
LLM_THINKING=low

# 快模型：只负责「该调哪个工具」和「把工具结果组织成话」，不要求文采。
# 实测首字延迟 glm-4.5-air 0.7 秒 / glm-5.3-flash 4～11 秒，
# 这是整条链路里最有效的提速开关。留空则全部用 LLM_MODEL（每次会慢 3～5 秒）。
LLM_ROUTE_MODEL=glm-4.5-air

# ---- 邮件发送（可选）----
# 不配置时导出接口产出 .eml 文件，双击即进本地邮件客户端，功能同样闭环。
# 配置后 /api/export/send/{sid} 会真实投递。
AG_SMTP_HOST=
AG_SMTP_PORT=465
AG_SMTP_USER=
AG_SMTP_PASS=
AG_SMTP_FROM_NAME=学业护航

# ---- 定时日报（可选）----
# 后台线程按间隔生成班级日报，单位分钟；AG_REPORT_HOUR 指定每天汇总的整点。
AG_REPORT_INTERVAL_MIN=0
AG_REPORT_HOUR=18
